{
  "expo": {
    "name": "MOONFLOW",
    "slug": "moonflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moonflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow MOONFLOW to access photos and save media to your gallery.",
        "NSPhotoLibraryAddUsageDescription": "Allow MOONFLOW to save downloaded videos and audio."
      }
    },
    "android": {
      "package": "com.moonhub.moonflow",
      "adaptiveIcon": {
        "backgroundColor": "#0B0819",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0819",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MOONFLOW to access photos and save media to your gallery.",
          "savePhotosPermission": "Allow MOONFLOW to save downloaded videos and audio."
        }
      ],
      "expo-video",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a61f6837-1faa-4010-9659-36caea27eff4"
      }
    }
  }
}
